{
  "name": "pisvis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A small, original 2D physics visualization kernel for teaching and agents.",
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "llms.txt",
    "docs",
    "README.md",
    "LICENSE",
    "AGENTS.md"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.cli.json",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cli.json",
    "build:demo": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:browser": "npm run build && playwright test",
    "check": "npm run typecheck && npm test && npm run agent-docs:check",
    "verify:all": "npm run check && npm run build:demo",
    "agent-docs:write": "npm run build && node scripts/agent-docs.mjs --write",
    "agent-docs:check": "node scripts/agent-docs.mjs --check",
    "test:pack": "node scripts/pack-test.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.5",
    "typescript": "6.0.3",
    "vite": "8.3.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@valibot/to-json-schema": "1.8.0",
    "valibot": "1.5.0"
  },
  "bin": {
    "pisvis": "./dist/cli/pisvis.js",
    "pisvis-mcp": "./dist/mcp/server.js"
  }
}
